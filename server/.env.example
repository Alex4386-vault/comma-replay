# Copy to .env and edit. Compose loads this file for ${VAR} substitution
# and passes matching keys into the container via env_file.

REPLAY_PORT=8080
REPLAY_DATA_HOST=./data
REPLAY_FRONTEND_ORIGIN=http://localhost:5173,https://comma-replay.pages.dev
# Public Client IDs (also used by SPA authorize redirect via VITE_* / bake)
REPLAY_GOOGLE_CLIENT_ID=
REPLAY_GITHUB_CLIENT_ID=
# Server-only secrets for code→token exchange (never put these in the FE / git)
# REPLAY_GOOGLE_CLIENT_SECRET=
REPLAY_GITHUB_CLIENT_SECRET=
# REPLAY_ALLOWED_USER_IDS=
